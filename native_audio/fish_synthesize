#!/bin/bash
# Lanceur du sidecar Fish Audio local — exécute fish_local.py sous JARVIS_VENV
# (le venv qui porte mlx-audio). Aucun réseau : HF_HUB_OFFLINE est forcé.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
VENV="${JARVIS_VENV:-$HOME/mlx-env}"
PYTHON="${VENV}/bin/python"
if [[ ! -x "$PYTHON" ]]; then
  echo "[fish-local] Python MLX introuvable: $PYTHON (pip install mlx-audio dans JARVIS_VENV)" >&2
  exit 127
fi
export HF_HUB_OFFLINE=1
export HF_HUB_DISABLE_TELEMETRY=1
exec "$PYTHON" "$DIR/fish_local.py" "$@"
