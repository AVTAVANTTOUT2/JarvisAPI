#!/bin/bash
# Lanceur sidecar Kokoro MLX — exécute kokoro_mlx.py sous JARVIS_VENV (mlx-audio).
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
VENV="${JARVIS_VENV:-$HOME/mlx-env}"
PYTHON="${VENV}/bin/python"
if [[ ! -x "$PYTHON" ]]; then
  echo "[kokoro-mlx] Python MLX introuvable: $PYTHON (pip install mlx-audio misaki dans JARVIS_VENV)" >&2
  exit 127
fi
exec "$PYTHON" "$DIR/kokoro_mlx.py" "$@"
